rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidArena(arena) {
      return arena is string && arena in ['courtyard', 'parking_deck', 'helipad'];
    }

    function isValidSkin(skinId) {
      return skinId is string && skinId in [
        'nightwatch',
        'crimson_recon',
        'hazmat_breacher',
        'cyber_ronin',
        'storm_phantom',
        'golden_sovereign'
      ];
    }

    function isValidPlatform(platform) {
      return platform is string && platform in ['Web', 'APK'];
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid',
          'callsign',
          'wave',
          'kills',
          'score',
          'mode',
          'arena',
          'skinId',
          'platform',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'callsign',
          'wave',
          'kills',
          'score',
          'mode',
          'arena',
          'skinId',
          'platform',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.callsign is string
        && data.callsign.size() >= 3
        && data.callsign.size() <= 12
        && data.callsign.matches('^[A-Za-z0-9_]{3,12}$')
        && data.wave is int
        && data.wave >= 1
        && data.wave <= 999
        && data.kills is int
        && data.kills >= 0
        && data.kills <= 1000000
        && data.score is int
        && data.score >= 0
        && data.score <= 100000000
        && data.mode is string
        && data.mode in ['normal', 'storm', 'blackout', 'boss_rush', 'daily']
        && isValidArena(data.arena)
        && isValidSkin(data.skinId)
        && isValidPlatform(data.platform)
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDailyLeaderboardEntry(data, dateKey) {
      return data.keys().hasAll([
          'uid',
          'callsign',
          'dateKey',
          'mutator',
          'wave',
          'kills',
          'score',
          'mode',
          'arena',
          'skinId',
          'platform',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'callsign',
          'dateKey',
          'mutator',
          'wave',
          'kills',
          'score',
          'mode',
          'arena',
          'skinId',
          'platform',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.callsign is string
        && data.callsign.size() >= 3
        && data.callsign.size() <= 12
        && data.callsign.matches('^[A-Za-z0-9_]{3,12}$')
        && data.dateKey is string
        && data.dateKey == dateKey
        && data.mutator is string
        && data.mutator.size() >= 1
        && data.mutator.size() <= 48
        && data.wave is int
        && data.wave >= 1
        && data.wave <= 999
        && data.kills is int
        && data.kills >= 0
        && data.kills <= 1000000
        && data.score is int
        && data.score >= 0
        && data.score <= 100000000
        && data.mode is string
        && data.mode == 'daily'
        && isValidArena(data.arena)
        && isValidSkin(data.skinId)
        && isValidPlatform(data.platform)
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Public read-only Android APK release metadata (zero PII, admin-managed)
    match /config/{configId} {
      allow get: if isValidId(configId) && configId == 'app';
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Global Top 20 personal-best high score leaderboard (zero PII stored)
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId) && (resource == null || existing().isPublic == true);
      allow list: if resource == null || existing().score >= 0;

      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && entryId == request.auth.uid
        && isValidLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && entryId == request.auth.uid
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().score >= existing().score;

      allow delete: if isVerifiedUser()
        && isValidId(entryId)
        && entryId == request.auth.uid;
    }

    // Daily Seeded Challenge leaderboard partitioned by UTC YYYY-MM-DD
    match /daily_leaderboard/{dateKey}/entries/{entryId} {
      allow get: if isValidDateKey(dateKey) && isValidId(entryId) && (resource == null || existing().isPublic == true);
      allow list: if isValidDateKey(dateKey) && (resource == null || existing().score >= 0);

      allow create: if isVerifiedUser()
        && isValidDateKey(dateKey)
        && isValidId(entryId)
        && entryId == request.auth.uid
        && isValidDailyLeaderboardEntry(incoming(), dateKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidDateKey(dateKey)
        && isValidId(entryId)
        && entryId == request.auth.uid
        && isValidDailyLeaderboardEntry(incoming(), dateKey)
        && incoming().uid == existing().uid
        && incoming().dateKey == existing().dateKey
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().score >= existing().score;

      allow delete: if isVerifiedUser()
        && isValidDateKey(dateKey)
        && isValidId(entryId)
        && entryId == request.auth.uid;
    }
  }
}
