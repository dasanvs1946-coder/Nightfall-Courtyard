rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll([
          'uid',
          'playerName',
          'score',
          'wave',
          'kills',
          'equippedGear',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'playerName',
          'score',
          'wave',
          'kills',
          'equippedGear',
          'isPublic',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.playerName is string
        && data.playerName.size() >= 1
        && data.playerName.size() <= 24
        && data.playerName.matches('^[a-zA-Z0-9 _\\-\\.]+$')
        && data.score is int
        && data.score >= 0
        && data.score <= 100000000
        && data.wave is int
        && data.wave >= 1
        && data.wave <= 999
        && data.kills is int
        && data.kills >= 0
        && data.kills <= 1000000
        && data.equippedGear is string
        && data.equippedGear in ['mine', 'turret', 'flashbang']
        && data.isPublic is bool
        && data.isPublic == true
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Global personal-best high score leaderboard (zero PII stored)
    match /leaderboard/{entryId} {
      allow get: if isValidId(entryId) && existing().isPublic == true;
      allow list: if existing().score >= 0;

      allow create: if isVerifiedUser()
        && isValidId(entryId)
        && entryId == request.auth.uid
        && isValidLeaderboardEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(entryId)
        && entryId == request.auth.uid
        && isValidLeaderboardEntry(incoming())
        && incoming().uid == existing().uid
        && incoming().isPublic == existing().isPublic
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Record a new personal best survival run
          (
            incoming().score >= existing().score
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'playerName',
              'score',
              'wave',
              'kills',
              'equippedGear',
              'updatedAt'
            ])
          )
          // Action 2: Update survivor callsign without changing stats
          || (
            incoming().score == existing().score
            && incoming().wave == existing().wave
            && incoming().kills == existing().kills
            && incoming().equippedGear == existing().equippedGear
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'playerName',
              'updatedAt'
            ])
          )
        );

      allow delete: if isVerifiedUser()
        && isValidId(entryId)
        && entryId == request.auth.uid;
    }
  }
}
