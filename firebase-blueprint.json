{
  "entities": {
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public personal-best survival run record for a signed-in player (including anonymous Firebase Auth) on the Nightfall Courtyard global Top 20 leaderboard.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID matching the document ID."
        },
        "callsign": {
          "type": "string",
          "minLength": 3,
          "maxLength": 15,
          "pattern": "^[A-Za-z0-9 ]{3,15}$",
          "description": "Public player name (3-15 letters, numbers, or spaces, zero PII)."
        },
        "clanTag": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "pattern": "^(|[A-Z0-9]{3,4})$",
          "description": "Optional 3-4 uppercase alphanumeric clan/squad tag."
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Client build version string (e.g. '3.0.0')."
        },
        "wave": {
          "type": "integer",
          "description": "Highest wave reached in the recorded run (1..200)."
        },
        "kills": {
          "type": "integer",
          "description": "Total infected eliminated in the recorded run (0..1000000)."
        },
        "score": {
          "type": "integer",
          "description": "Best run score achieved (0..100000000)."
        },
        "mode": {
          "type": "string",
          "enum": ["normal", "storm", "blackout", "boss_rush", "extraction", "siege", "weekly", "daily"],
          "description": "Game mode played during the recorded run."
        },
        "arena": {
          "type": "string",
          "enum": ["courtyard", "parking_deck", "helipad", "subway", "biolab", "rooftop"],
          "description": "Arena map selected during the recorded run."
        },
        "skinId": {
          "type": "string",
          "enum": [
            "nightwatch",
            "crimson_recon",
            "hazmat_breacher",
            "cyber_ronin",
            "storm_phantom",
            "golden_sovereign"
          ],
          "description": "Equipped operative skin ID for badge rendering."
        },
        "platform": {
          "type": "string",
          "enum": ["Web", "APK"],
          "description": "Client runtime platform tag."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Always true; marks entry visible on public leaderboard."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when player first joined the leaderboard."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest personal best update."
        }
      },
      "required": [
        "uid",
        "callsign",
        "wave",
        "kills",
        "score",
        "mode",
        "arena",
        "skinId",
        "platform",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyLeaderboardEntry": {
      "title": "DailyLeaderboardEntry",
      "description": "Public personal-best survival run record for a UTC Daily Seeded Challenge.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID matching the document ID."
        },
        "callsign": {
          "type": "string",
          "minLength": 3,
          "maxLength": 15,
          "pattern": "^[A-Za-z0-9 ]{3,15}$",
          "description": "Public player name (3-15 letters, numbers, or spaces)."
        },
        "clanTag": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "pattern": "^(|[A-Z0-9]{3,4})$",
          "description": "Optional 3-4 uppercase alphanumeric clan/squad tag."
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Client build version string."
        },
        "dateKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$",
          "description": "UTC date key YYYY-MM-DD matching the daily challenge."
        },
        "mutator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48,
          "description": "Daily mutator identifier for the UTC seed."
        },
        "wave": {
          "type": "integer",
          "description": "Wave reached in the Daily Run (1..200)."
        },
        "kills": {
          "type": "integer",
          "description": "Total infected eliminated in the Daily Run (0..1000000)."
        },
        "score": {
          "type": "integer",
          "description": "Best score achieved on this UTC day (0..100000000)."
        },
        "mode": {
          "type": "string",
          "enum": ["daily"],
          "description": "Always 'daily' for daily seeded runs."
        },
        "arena": {
          "type": "string",
          "enum": ["courtyard", "parking_deck", "helipad", "subway", "biolab", "rooftop"],
          "description": "Deterministic arena for this UTC date."
        },
        "skinId": {
          "type": "string",
          "enum": [
            "nightwatch",
            "crimson_recon",
            "hazmat_breacher",
            "cyber_ronin",
            "storm_phantom",
            "golden_sovereign"
          ],
          "description": "Equipped operative skin ID."
        },
        "platform": {
          "type": "string",
          "enum": ["Web", "APK"],
          "description": "Client runtime platform tag."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Always true."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when entry was updated."
        }
      },
      "required": [
        "uid",
        "callsign",
        "dateKey",
        "mutator",
        "wave",
        "kills",
        "score",
        "mode",
        "arena",
        "skinId",
        "platform",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "PlayerSave": {
      "title": "PlayerSave",
      "description": "Cloud save backup for player career progression (Scrap, skins, classes, Tech Lab, camos, mastery, daily contracts) tied to silent anonymous Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "callsign": {
          "type": "string",
          "minLength": 3,
          "maxLength": 15,
          "pattern": "^[A-Za-z0-9 ]{3,15}$",
          "description": "Player callsign."
        },
        "clanTag": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "pattern": "^(|[A-Z0-9]{3,4})$",
          "description": "Optional 3-4 character clan tag."
        },
        "highScore": {
          "type": "integer",
          "description": "Saved personal best score."
        },
        "career": {
          "type": "object",
          "description": "Sanitized CareerStats map (Scrap, skins, classes, weapons, drones, Tech Lab, kills, contracts)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last cloud backup."
        }
      },
      "required": ["uid", "callsign", "clanTag", "highScore", "career", "updatedAt"]
    },
    "TransferCodeRecord": {
      "title": "TransferCodeRecord",
      "description": "Short 6-character cross-device save transfer payload stored under transfer_codes/{code}.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6,
          "pattern": "^[A-Z0-9]{6}$",
          "description": "6-character uppercase alphanumeric transfer code."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the device that generated the transfer code."
        },
        "callsign": {
          "type": "string",
          "minLength": 3,
          "maxLength": 15,
          "pattern": "^[A-Za-z0-9 ]{3,15}$",
          "description": "Transferred player callsign."
        },
        "clanTag": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4,
          "pattern": "^(|[A-Z0-9]{3,4})$",
          "description": "Transferred clan tag."
        },
        "highScore": {
          "type": "integer",
          "description": "Transferred personal best score."
        },
        "career": {
          "type": "object",
          "description": "Full sanitized CareerStats progression snapshot."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when code was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when code was refreshed."
        }
      },
      "required": ["code", "ownerUid", "callsign", "clanTag", "highScore", "career", "createdAt", "updatedAt"]
    },
    "PlayerLoginRecord": {
      "title": "PlayerLoginRecord",
      "description": "Silent platform analytics record tracking APK vs WEB login counts per anonymous UID (zero PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Authenticated Firebase UID matching the document ID."
        },
        "platform": {
          "type": "string",
          "enum": ["APK", "WEB"],
          "description": "Client runtime platform ('APK' or 'WEB')."
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Client hostname (window.location.hostname)."
        },
        "loginCount": {
          "type": "integer",
          "description": "Cumulative login session count."
        },
        "lastLoginAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest anonymous auth login."
        }
      },
      "required": ["uid", "platform", "host", "loginCount", "lastLoginAt"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Public read-only release metadata stored at config/app for Android APK and Web update banners.",
      "type": "object",
      "properties": {
        "latestVersion": {
          "type": "string",
          "description": "Semantic version string (e.g. '3.0.0' or 'v3.0.0')."
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "description": "Direct APK / release download URL for native Android clients."
        },
        "changelog": {
          "type": "string",
          "description": "Short release notes summary displayed on the update banner."
        }
      },
      "required": ["latestVersion", "downloadUrl"]
    }
  },
  "firestore": {
    "/leaderboard/{playerId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Global Top 20 personal-best high score entries keyed by authenticated player UID (including anonymous auth)."
    },
    "/daily_leaderboard/{dateKey}/entries/{playerId}": {
      "schema": {
        "$ref": "#/entities/DailyLeaderboardEntry"
      },
      "description": "Daily Seeded Challenge leaderboard entries keyed by UTC date and authenticated player UID."
    },
    "/players/{playerId}": {
      "schema": {
        "$ref": "#/entities/PlayerSave"
      },
      "description": "Private cloud save progression keyed by authenticated player UID."
    },
    "/transfer_codes/{code}": {
      "schema": {
        "$ref": "#/entities/TransferCodeRecord"
      },
      "description": "Cross-device 6-character save transfer snapshots."
    },
    "/player_logins/{playerId}": {
      "schema": {
        "$ref": "#/entities/PlayerLoginRecord"
      },
      "description": "Silent platform login analytics keyed by authenticated player UID."
    },
    "/config/{configId}": {
      "schema": {
        "$ref": "#/entities/AppConfig"
      },
      "description": "Public read-only app configuration document (config/app) for update checks."
    }
  }
}
